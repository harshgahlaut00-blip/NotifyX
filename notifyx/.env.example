# ─────────────────────────────────────────────────────────────
#  NotifyX configuration — copy to `.env` (or set these in your
#  hosting panel's "Startup / Variables" tab). NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ── Discord (required) ───────────────────────────────────────
# Bot token from https://discord.com/developers/applications  →  Bot  →  Reset Token
DISCORD_TOKEN=
# Optional: defaults to the bot's own application ID. Needed only for `npm run deploy-commands`.
DISCORD_CLIENT_ID=
# Optional: register slash commands to ONE server instantly (great while testing).
# Leave empty for global commands.
DISCORD_DEV_GUILD_ID=
# auto  = register commands only when they changed (recommended)
# force = register on every start,  off = never register automatically
COMMAND_SYNC=auto

# ── Local JSON database ────────────────────────────────────
# No PostgreSQL server is required. NotifyX stores its data in data/database.json.
# Keep the data/ directory persistent on your host.

# ── YouTube Data API v3 (required for /youtube add) ──────────
YOUTUBE_API_KEY=
# How often each channel's uploads are checked when relying on polling alone (no PUBLIC_URL set).
# 300 = 5 min. This is the fallback/safety-net path — see the PUBLIC_URL setting above for instant
# delivery instead. Once PUBLIC_URL is set, an account with an active push subscription is polled
# far less often automatically (this interval still applies to newly-added channels and as a backstop).
YOUTUBE_POLL_INTERVAL_SECONDS=300
# How often known upcoming/live streams are re-checked for state changes (e.g. scheduled -> live).
# This only runs while something is actually upcoming/live, so it's cheap to keep short — 60s means
# a scheduled stream going live is detected within ~1 minute even without a push for that transition.
YOUTUBE_LIVE_CHECK_INTERVAL_SECONDS=60
# How new uploads are discovered:
#   auto = YouTube's public channel feed first (costs NO API quota), API playlist as fallback  [default]
#   rss  = feed only     api = API playlist only (1 quota unit per channel per check)
# Video details (title, live status...) always come from the official API.
YOUTUBE_DISCOVERY=auto

# ── Optional: YouTube push notifications (WebSub / PubSubHubbub) ──
# ⚡ THIS IS THE SETTING THAT MAKES NOTIFICATIONS INSTANT. ⚡
# Set this to a PUBLIC https URL that reaches this bot's HTTP port, e.g. https://bot.example.com
# When set, YouTube pushes a message to the bot within seconds of a new upload — the bot fetches
# just that one video and notifies immediately, instead of waiting for the next scheduled poll.
# Without it, NotifyX still works, just on a polling schedule (see YOUTUBE_POLL_INTERVAL_SECONDS
# below) — fine for casual use, but "instant" specifically requires this.
#
# Don't have a public URL? Any of these give you one for free, pointed at this bot's PORT:
#   - Many hosting panels (Pterodactyl etc.) already expose a public domain/port for you — use that.
#   - Cloudflare Tunnel:  cloudflared tunnel --url http://localhost:3000
#   - ngrok:              ngrok http 3000
# Use the https URL it gives you (no trailing slash) as PUBLIC_URL below.
PUBLIC_URL=
# Optional. If empty, a secret is derived from your bot token.
WEBSUB_SECRET=

# ── Limits & retention ───────────────────────────────────────
MAX_CHANNELS_PER_GUILD=25
# Never announce content older than this (protects against floods after long downtime).
MAX_NOTIFICATION_AGE_HOURS=48
HISTORY_RETENTION_DAYS=90

# ── HTTP health-check server ─────────────────────────────────
HTTP_ENABLED=true
# Pterodactyl exposes SERVER_PORT automatically; PORT wins if both are set.
PORT=2000
HTTP_HOST=0.0.0.0

# ── Logging ──────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Human-readable logs (needs the optional pino-pretty package). Leave false in production/Docker.
LOG_PRETTY=false
# Optional: also write JSON logs to this file.
LOG_FILE=

# ── Custom emoji (all optional) ──────────────────────────────
# Accepts:  <:name:id>  |  <a:name:id>  |  a numeric emoji ID  |  the name of an *application emoji*  |  a Unicode emoji
# If the emoji cannot be found/used, NotifyX silently falls back to a Unicode emoji.
# Servers can override these with /settings emoji set.
EMOJI_VIDEO=
EMOJI_LIVE=
EMOJI_UPCOMING=
EMOJI_WATCH=
EMOJI_CHANNEL=
EMOJI_CALENDAR=
EMOJI_SUCCESS=
EMOJI_ERROR=
EMOJI_WARNING=
EMOJI_INFO=
EMOJI_SETTINGS=

# Public HTTPS WebSub callback provided by your Cloudflare Worker relay.
PUBLIC_URL=https://notifyx-relay.harshgahlaut00.workers.dev
